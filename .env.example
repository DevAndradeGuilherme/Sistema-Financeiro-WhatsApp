# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Todos os valores abaixo são placeholders fictícios.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# --- Banco (PostgreSQL / Supabase) ---
DB_NAME=controle_gastos
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# disable em container local; require em Supabase
DB_SSLMODE=disable
# Transaction pooler do Supabase: CONN_MAX_AGE=0 e DISABLE_SERVER_SIDE_CURSORS=True
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- OpenAI ---
OPENAI_API_KEY=replace-me
# Obrigatório. Nome do modelo usado em runtime (não hardcoded no código).
OPENAI_MODEL=replace-with-model-name
OPENAI_TIMEOUT_SECONDS=20

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_BASE_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-me
EVOLUTION_INSTANCE_NAME=controle-gastos
# Segredo compartilhado validado no webhook
EVOLUTION_WEBHOOK_SECRET=replace-me-with-a-long-random-string
EVOLUTION_TIMEOUT_SECONDS=10

# --- Supabase Storage (V1.4; deixar vazio até lá) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Domínio ---
# Limite superior por transação (BRL) para barrar erros de interpretação
TRANSACTION_MAX_AMOUNT=1000000.00
