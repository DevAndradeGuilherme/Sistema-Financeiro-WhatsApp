# Copie para .env e preencha. NUNCA versione o arquivo .env.
# Todos os valores abaixo são placeholders fictícios.

# --- Django ---
# development | production (production ativa guardas e cookies/HSTS seguros)
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_ADMIN_URL=admin/
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# --- Banco (PostgreSQL / Supabase) ---
DB_NAME=controle_gastos
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# disable em container local; require em Supabase
DB_SSLMODE=disable
# Transaction pooler do Supabase: CONN_MAX_AGE=0 e DISABLE_SERVER_SIDE_CURSORS=True
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=False
DB_CONNECT_TIMEOUT=10
# Habilita RLS (sem policies) em todas as tabelas após migrate. Ver docs/DATABASE.md
DB_ENABLE_RLS=True

# --- Banco de testes (somente PostgreSQL local; Supabase é recusado) ---
# Padrões apontam para: docker compose --profile test up -d test-db
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5433
# TEST_DB_NAME=controle_gastos
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres

# --- Gunicorn ---
GUNICORN_WORKERS=2
# Deve superar a soma do pior caminho síncrono (mídia + IA/Storage + resposta).
GUNICORN_TIMEOUT=120

# --- OpenAI ---
OPENAI_API_KEY=replace-me
# Obrigatório. Nome do modelo usado em runtime (não hardcoded no código).
OPENAI_MODEL=replace-with-model-name
OPENAI_TIMEOUT_SECONDS=20
# Opcional: none | low | medium | high. Vazio = não enviado (padrão do modelo).
OPENAI_REASONING_EFFORT=
# Áudio (V1.3): modelo de transcrição (obrigatório para áudio), timeout e limites
OPENAI_TRANSCRIPTION_MODEL=replace-with-transcription-model
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=30
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_SECONDS=300
# Minutos que a última consulta vale para follow-ups ("e mês passado?")
CONVERSATION_CONTEXT_TTL_MINUTES=20

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_BASE_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-me
EVOLUTION_INSTANCE_NAME=controle-gastos
# Segredo compartilhado: enviado pela Evolution no header X-Webhook-Secret
EVOLUTION_WEBHOOK_SECRET=replace-me-with-a-long-random-string
EVOLUTION_TIMEOUT_SECONDS=10

# --- Imagens de comprovante (V1.4) ---
# Processadas em memória e descartadas: nada vai para Storage (sem service role key).
OPENAI_VISION_MODEL=replace-with-vision-model
OPENAI_VISION_TIMEOUT_SECONDS=30
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=40000000

# --- Domínio ---
# Limite superior por transação (BRL) para barrar erros de interpretação
TRANSACTION_MAX_AMOUNT=1000000.00
